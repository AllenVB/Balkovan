# Sitenin yayindaki adresi. sitemap, robots ve paylasim etiketleri bunu kullanir.
# Alan adi belli olunca burayi doldurun (sonunda / olmadan).
NEXT_PUBLIC_SITE_URL=https://balkovan.com.tr

# Gelistirme veritabani (docker-compose.yml ile ayaga kalkar).
DATABASE_URL=postgresql://balkovan:balkovan@localhost:5434/balkovan

# Oturum imzalama anahtari. Uretmek icin: npx auth secret
AUTH_SECRET=
